# The Apps Script Web App URL (ends in /exec). Get this from the sheet's Extensions > Apps
# Script > Deploy > New deployment > Web app, after pasting in apps-script/Code.gs.
APPS_SCRIPT_URL=

# Must exactly match the "SHARED_SECRET" script property you set in Apps Script
# (Project Settings > Script Properties). Generate with: openssl rand -base64 48
APPS_SCRIPT_SHARED_SECRET=

# Random secret used to sign agent link tokens and the admin login cookie.
# Generate with: openssl rand -base64 48
APP_TOKEN_SECRET=

# Password checked by /admin - anyone with it can see every agent's private link.
ADMIN_PASSWORD=

# Used to build shareable /entry/<token> links on the admin page.
APP_BASE_URL=http://localhost:3000

# IANA timezone name. Must match the spreadsheet's own File > Settings > timezone,
# or "today"/"this week" can be off by a day right around midnight.
APP_TIMEZONE=Asia/Dubai
